RSVP_SHEET_WEBHOOK=
ADMIN_PASSWORD=

# Server-only. Used when a Groom invitation RSVP is saved to Google Sheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

# Public URL of the hosted RSVP API. The static Groom page posts here.
# Example: https://your-api-host.example.com/api/rsvp
NEXT_PUBLIC_RSVP_API_URL=

# Extra browser origins allowed to call the RSVP API, comma-separated.
# localhost:3000 and https://raiyaan555.github.io are already allowed.
RSVP_ALLOWED_ORIGINS=
