RSVP_SHEET_WEBHOOK=
ADMIN_PASSWORD=

# Server-only. Used when a Groom invitation RSVP is saved to Google Sheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

# Public Groom RSVP endpoint, baked into the GitHub Pages build.
# Use the Google Apps Script Web App /exec URL. Leave this empty locally
# so the Groom form keeps posting to the local /api/rsvp route.
# Example: https://script.google.com/macros/s/XXXXXXXX/exec
NEXT_PUBLIC_RSVP_API_URL=

# Extra browser origins allowed to call the RSVP API, comma-separated.
# localhost:3000 and https://raiyaan555.github.io are already allowed.
RSVP_ALLOWED_ORIGINS=
